# ═════════════════════════════════════════════════════════════════════════════
# TDAI Global Images - Deploy Linux Server - File .env
# Máy deploy: Linux (Ubuntu/Debian), IP LAN 10.10.10.126
# Relay LLM chạy ngay trên máy deploy này (bind 0.0.0.0:20128).
# LLM key/model lấy từ cấu hình local (giữ nguyên relay hiện tại).
#
#   ./start-all.sh   -> khởi động cả 3 service
# ═════════════════════════════════════════════════════════════════════════════

# ── Image tag ────────────────────────────────────────────────────────────────
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
PROXY_IMAGE=agentmemory/memory-proxy:latest

# ── Nhóm memory: LLM mà memory + memory-hub dùng nội bộ ──────────────────────
# Relay LLM chạy trên HOST của máy deploy. Container gọi host qua IP LAN
# 10.10.10.126 (không dùng 127.0.0.1 — trong container đó là chính container).
# Yêu cầu: relay phải bind 0.0.0.0:20128 (không chỉ 127.0.0.1).
MEMORY_LLM_BASE_URL=http://10.10.10.126:20128/v1
MEMORY_LLM_API_KEY=sk-c8beeb45304bff2e-otrslz-ca1baccd
MEMORY_LLM_MODEL=xkiro
MEMORY_LLM_PROTOCOL=openai                  # openai | anthropic

# ── Nhóm proxy: LLM upstream mà proxy chuyển tiếp request người dùng tới ─────
PROXY_UPSTREAM_URL=http://10.10.10.126:20128/v1
PROXY_UPSTREAM_API_KEY=sk-c8beeb45304bff2e-otrslz-ca1baccd
PROXY_UPSTREAM_MODEL=xkiro

# ── Cổng ─────────────────────────────────────────────────────────────────────
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ── Địa chỉ ngoài mà Knowledge Service cần phơi ra (memory-hub bắt buộc) ─────
# PHẢI có tiền tố /v3. Dùng IP LAN của máy deploy để truy cập được từ máy khác.
KNOWLEDGE_PUBLIC_BASE_URL=http://10.10.10.126:8424/v3

# ── Panel UI "Địa chỉ kết nối client" (Card hiển thị) ────────────────────────
# Coding agent (Claude Code / CodeBuddy...) chạy từ máy khác sẽ trỏ tới proxy
# qua IP này. Đặt IP LAN 10.10.10.126 để copy URL trên panel là dùng được ngay.
MEMORY_HUB_PROXY_PUBLIC_URL=http://10.10.10.126:8096

# ── Tên volume dữ liệu ────────────────────────────────────────────────────────
MEMORY_CORE_VOLUME=tdai-memory-core-data
PANEL_VOLUME=tdai-panel-data

# ── Credential nội bộ của memory-core ────────────────────────────────────────
# Để trống = tắt Bearer gate (zero-config). Đừng đặt giá trị: proxy gọi
# /v3/meta/auth/verify KHÔNG gửi Bearer header (đã biết không tương thích),
# đặt key sẽ làm auth/sessionInit của proxy fail.
MEMORY_CORE_GATEWAY_API_KEY=

# Tên admin (init-admin lần đầu). Script tự sinh random sk-mem-* lưu vào ./.admin-key.
MEMORY_CORE_ADMIN_USERNAME=admin
# ── Proxy feature flags ────────────────────────────────────────────────────────
PROXY_ENABLE_AUTH=1
PROXY_ENABLE_TDAI=1
PROXY_ENABLE_SESSION_INIT=1
