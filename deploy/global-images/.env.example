# ═════════════════════════════════════════════════════════════════════════════
# TDAI Global Images - Deploy Local - File mẫu biến môi trường
#
# Cách dùng:
#   cp .env.example .env
#   # sửa .env, thay REPLACE_ME bằng giá trị thật của bạn
#   ./start-all.sh
#
# Hai nhóm tham số độc lập:
#   MEMORY_*   → memory + memory-hub dùng (LLM của dịch vụ memory/knowledge nội bộ)
#   PROXY_*    → proxy dùng (LLM upstream mà proxy chuyển tiếp request người dùng tới)
# Hai nhóm có thể giống nhau, cũng có thể trỏ tới model/nhà cung cấp hoàn toàn khác nhau.
# ═════════════════════════════════════════════════════════════════════════════

# ── Image tag ─────────────────────────────────────────────────────────────────
# Mặc định dùng image công khai trên Docker Hub (multi-arch amd64 + arm64, docker pull không cần đăng nhập):
#   https://hub.docker.com/r/agentmemory/memory-core
#   https://hub.docker.com/r/agentmemory/memory-proxy
#   https://hub.docker.com/r/agentmemory/memory-hub
# Muốn khóa phiên bản thì đổi :latest thành phiên bản cụ thể, ví dụ :1.0.0-beta.1.
# Lưu ý: nếu máy đã có image trùng tên :latest, script sẽ dùng lại trực tiếp, không tự biết bản mới trên remote.
# Muốn kéo bản mới nhất thì dùng `PULL=1 ./start-all.sh`.
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
PROXY_IMAGE=agentmemory/memory-proxy:latest

# ── Lựa chọn nội bộ Tencent (cho đồng nghiệp nội bộ) ──────────────────────────
# Môi trường nội bộ (mạng nội bộ Tencent / devcloud) có thể ghi đè thành private registry
# mirrors.tencent.com, không cần đi qua Docker Hub công khai. Trước khi dùng hãy `docker login mirrors.tencent.com`.
# MEMORY_CORE_IMAGE=mirrors.tencent.com/memory-team-control/memory-core:latest
# MEMORY_HUB_IMAGE=mirrors.tencent.com/memory-team-control/memory-hub:latest
# PROXY_IMAGE=mirrors.tencent.com/memory-team-control/proxy:latest

# ── Nhóm memory: LLM mà memory + memory-hub gọi nội bộ ────────────────────────
# Công dụng: embed/summarize của memory; wiki ingest / tổng hợp trong memory-hub
MEMORY_LLM_BASE_URL=REPLACE_ME              # vd: https://api.deepseek.com/v1
MEMORY_LLM_API_KEY=REPLACE_ME               # vd: sk-xxxxxxxx
MEMORY_LLM_MODEL=REPLACE_ME                 # vd: deepseek-chat
MEMORY_LLM_PROTOCOL=openai                  # openai | anthropic

# ── Nhóm proxy: LLM upstream mà proxy chuyển tiếp request người dùng tới ──────
# Công dụng: coding agent / client gọi proxy:8096, proxy chuyển tiếp tới đây
PROXY_UPSTREAM_URL=REPLACE_ME               # vd: https://api.deepseek.com/v1
PROXY_UPSTREAM_API_KEY=REPLACE_ME           # vd: sk-xxxxxxxx (có thể khác nhóm memory)
PROXY_UPSTREAM_MODEL=REPLACE_ME             # vd: deepseek-chat

# ── Cổng (mặc định dùng được; nếu local xung đột thì sửa ở đây) ───────────────
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ── Địa chỉ ngoài mà knowledge phơi ra (memory-hub bắt buộc) ──────────────────
# Để agent / gateway truy cập được interface tools của KS. PHẢI có tiền tố /v3.
# Kịch bản local mặc định dùng host.docker.internal để container trong vòng lặp tới host.
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3

# ── Base URL hiển thị trong thẻ "Địa chỉ kết nối client" của Panel UI (chỉ dùng deploy local open source) ──
# Deploy open source core và proxy chạy riêng, client coding agent cần kết nối tới proxy, không phải core/gateway.
# Giá trị này chỉ dùng để Panel UI ghép hiển thị (như card copy baseUrl của CodeBuddy / ClaudeCode),
# còn Panel backend → Kernel chuyển tiếp luôn đi theo REMOTE_INSTANCE_URL (=memory-core), không bị biến này ảnh hưởng.
#
# Khi chưa đặt, script tự động dò LAN IP của host (`hostname -I` / trên macOS `ipconfig getifaddr en0`)
# rồi ghép thành `http://<lan-ip>:${PROXY_PORT}` —— máy khác copy card URL là kết nối được ngay.
# Đặt tường minh là chuỗi rỗng (="") thì về hành vi cũ fallback về gateway_endpoint.
# Muốn chỉ định rõ (ví dụ domain công khai / IP card cụ thể) thì bỏ comment dòng dưới và điền giá trị thật:
# MEMORY_HUB_PROXY_PUBLIC_URL=http://192.168.1.100:8096

# ── Tên volume dữ liệu ─────────────────────────────────────────────────────────
MEMORY_CORE_VOLUME=tdai-memory-core-data
PANEL_VOLUME=tdai-panel-data

# ── Thông tin quản trị nội bộ của memory-core ─────────────────────────────────
# Thông tin quản trị lớp Bearer của Gateway.
#   Để trống (mặc định) —— tắt Bearer gate (trải nghiệm zero-config local; auth/sessionInit của proxy
#                    chỉ kết nối trực tiếp được với memory-core trong cấu hình này, xem comment đầu start-memory-core.sh)
#   Khác rỗng        —— mọi request phải kèm `Authorization: Bearer <key>`; proxy hiện tại
#                    không gửi header này, nên auth/sessionInit của proxy sẽ fail
# Khi đi production, cần sửa phía proxy trước rồi mới bật key khác rỗng.
MEMORY_CORE_GATEWAY_API_KEY=

# Tên admin (dùng lần đầu init-admin). user_key được script lần khởi động đầu tự sinh một key sk-mem- ngẫu nhiên
# lưu vào ./.admin-key —— các script / claude-proxy sau này đọc từ file này, không cần tự điền tay.
MEMORY_CORE_ADMIN_USERNAME=admin
# ── Proxy feature flags ────────────────────────────────────────────────────────
# PROXY_ENABLE_AUTH=1          # Bật xác thực (cần cho picker)
# PROXY_ENABLE_TDAI=1          # Bật memory injection
# PROXY_ENABLE_SESSION_INIT=1  # Bật session init (hiển thị picker)
